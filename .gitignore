# Generated by Cargo
# will have compiled files and executables
debug
target

# Trunk web build output (wasm/js bundle)
dist

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Flatpak
flatpak/cargo-sources.json
flatpak/io.github.HakanSeven12.OpenCadStudio.local.yml
.flatpak-builder/
build-dir/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Python bytecode
__pycache__/
*.pyc

# Claude Code local preview/dev-server config
.claude/launch.json

# Worktrees created for isolated runs
.claude/worktrees/

# Single-instance lock files the app writes next to an open drawing
*.ocs.lock

# Customer drawings and PLC exports — real production data, kept local only.
# (34 ACADE DXF sheets, 33 DWG, one RSLogix .ACD; ~45 MB)
import/

# Scratch drawings and probe output written by the headless ECAD test batches
tests/ecad/_probe*/
tests/ecad/_work/
reports/_tmp/
# Symbol-preview cache the app writes beside the drawing folder
.ecad/

# macOS Finder metadata
.DS_Store

# Plugin template has its own Cargo project (not part of the workspace build);
# its lock file is a locally generated build artifact
docs/plugin-template-v2/Cargo.lock
